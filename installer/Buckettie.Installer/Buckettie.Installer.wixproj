<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.2.1</ProductVersion>
    <DisplayVersion Condition="'$(DisplayVersion)' == ''">1.2.0.1</DisplayVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\.local\installer\publish</PublishDir>
    <OutputName>Buckettie-$(DisplayVersion)-win-x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);$(DefineConstants)</DefineConstants>
  </PropertyGroup>
</Project>
